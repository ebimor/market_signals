# Environment variables for SafeSwing Trader

# API Settings
API_HOST=localhost
API_PORT=8000
DEBUG=True

# Database
DATABASE_URL=sqlite:///./safeswing.db

# Market Data
MARKET_DATA_REFRESH_INTERVAL=60

# Risk Management
DEFAULT_ACCOUNT_RISK_PERCENT=0.01
DEFAULT_STOP_LOSS_ATR_MULTIPLIER=1.5
DEFAULT_TAKE_PROFIT_RATIO=2.0

# Signal Engine
VIX_THRESHOLD=30.0

# External APIs (add your keys here)
# POLYGON_API_KEY=your_key_here
# FINNHUB_API_KEY=your_key_here
# ALPACA_API_KEY=your_key_here
# ALPACA_SECRET_KEY=your_key_here
ALPACA_PAPER_TRADING=True
